# Copy this file to .env for local development and fill in only the values you
# need. Never commit a real secret.

# development or production. Production refuses to start without SECRET_KEY.
FLASK_ENV=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional SQLite path. The default is instance/janaushadhi.db and is rebuilt
# from the bundled validated CSV files when their hash changes.
# DATABASE_PATH=instance/janaushadhi.db

# Optional catalogue paths. Defaults are data/medicines.csv and
# data/kendras.csv. Use scripts/import_catalogue.py to update them safely.
# MEDICINES_CSV=data/medicines.csv
# KENDRAS_CSV=data/kendras.csv
# SOURCES_JSON=data/sources.json

# Set to 1 only when running behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Otherwise client IPs can be spoofed for rate limiting.
TRUST_PROXY=0

# In-process rate limiting. A shared store is needed for strict limits across
# multiple workers or instances.
RATELIMIT_ENABLED=1

# Rebuild the SQLite catalogue on every startup. Usually unnecessary.
CATALOGUE_RELOAD=0

# Optional token for GET /admin/feedback. Leave empty to keep that endpoint
# permanently unavailable (404). Never expose this token in client-side code.
ADMIN_TOKEN=

# Gunicorn tuning (used by the Dockerfile).
PORT=8000
WEB_CONCURRENCY=2
WEB_THREADS=4
